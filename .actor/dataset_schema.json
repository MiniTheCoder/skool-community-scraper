{
  "actorSpecification": 1,
  "fields": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier of the community"
      },
      "name": {
        "type": "string",
        "description": "Unique URL slug"
      },
      "displayName": {
        "type": "string",
        "description": "Public name of the community"
      },
      "url": {
        "type": "string",
        "description": "Direct URL link to the community"
      },
      "description": {
        "type": "string",
        "description": "Community tagline and description"
      },
      "totalMembers": {
        "type": "integer",
        "description": "Total member count"
      },
      "priceFormatted": {
        "type": "string",
        "description": "Formatted price (e.g. $69/month or Free)"
      },
      "isFree": {
        "type": "boolean",
        "description": "Whether the community is free"
      },
      "priceAmount": {
        "type": "number",
        "description": "Numeric price value"
      },
      "currency": {
        "type": "string",
        "description": "Currency code (USD)"
      },
      "billingInterval": {
        "type": "string",
        "description": "Recurring billing interval"
      },
      "reviewAverageRating": {
        "type": "number",
        "description": "Average review rating"
      },
      "reviewCount": {
        "type": "integer",
        "description": "Total number of reviews"
      },
      "logoUrl": {
        "type": "string",
        "description": "Logo / avatar URL"
      },
      "coverSmallUrl": {
        "type": "string",
        "description": "Cover banner URL"
      },
      "rank": {
        "type": "integer",
        "description": "Rank in discovery results"
      },
      "createdAt": {
        "type": "string",
        "description": "Creation timestamp"
      },
      "scrapedAt": {
        "type": "string",
        "description": "Scrape timestamp"
      }
    }
  },
  "views": {
    "overview": {
      "title": "Overview",
      "transformation": {
        "fields": [
          "displayName",
          "totalMembers",
          "priceFormatted",
          "reviewAverageRating",
          "reviewCount",
          "url"
        ]
      },
      "display": {
        "component": "table",
        "properties": {
          "displayName": {
            "label": "Community"
          },
          "totalMembers": {
            "label": "Members",
            "format": "number"
          },
          "priceFormatted": {
            "label": "Price"
          },
          "reviewAverageRating": {
            "label": "Rating",
            "format": "number"
          },
          "reviewCount": {
            "label": "Reviews",
            "format": "number"
          },
          "url": {
            "label": "Link",
            "format": "link"
          }
        }
      }
    }
  }
}
